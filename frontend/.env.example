# Copy to .env.local and supply keys from the existing Clerk application.
# Never commit real keys; only the publishable key may be a Docker build arg.
BACKEND_URL=http://localhost:8000
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_replace_me
CLERK_SECRET_KEY=sk_test_replace_me
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/

# Exact browser origin (scheme + hostname + optional port), not an internal
# service URL. Required in production; development defaults to localhost:3000.
# Set explicitly when using another dev port. No Host/forwarded headers trusted.
APP_ORIGIN=http://localhost:3000
