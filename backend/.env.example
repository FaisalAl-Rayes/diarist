# Create a read token at https://huggingface.co/settings/tokens after accepting
# the pyannote Community-1 model conditions.
HF_TOKEN=hf_...

# Where Whisper and pyannote model weights are cached (and where HF_TOKEN-gated
# downloads are stored). Point this at a persistent volume in production.
HF_HOME=/data/models

# Where uploaded audio, job state, and finished transcripts are stored.
JOB_DATA_DIR=/data/jobs

# faster-whisper model size/repo, device, and compute type.
WHISPER_MODEL=large-v3
WHISPER_DEVICE=cuda
WHISPER_COMPUTE_TYPE=float16

# pyannote diarization pipeline and device.
DIARIZATION_MODEL=pyannote/speaker-diarization-community-1
DIARIZATION_DEVICE=cuda

# Comma-separated list of origins allowed to call this API (the frontend's
# own origin). Leave empty to disable CORS entirely when the frontend proxies
# requests server-side instead of calling the API from the browser.
CORS_ORIGINS=
