# Create a read token at https://huggingface.co/settings/tokens after accepting
# the pyannote Community-1 model conditions.
HF_TOKEN=hf_...

# Where Whisper and pyannote model weights are cached (and where HF_TOKEN-gated
# downloads are stored). Point this at a persistent volume in production.
HF_HOME=/data/models

# Where uploaded audio, job state, and finished transcripts are stored.
JOB_DATA_DIR=/data/jobs

# Whisper backend: "auto" (default), "faster-whisper" (CUDA or CPU, works
# everywhere, including Docker), or "mlx" (Apple Silicon/Metal -- only
# installs and runs natively on macOS arm64; NEVER works inside Docker, on
# any host; see devices.py). "auto" picks mlx when running natively on
# Apple Silicon with `uv sync --extra mlx`, else faster-whisper.
WHISPER_BACKEND=auto

# faster-whisper model size/repo. Ignored (a different default is used) if
# WHISPER_BACKEND resolves to mlx.
WHISPER_MODEL=large-v3

# faster-whisper only; ignored for mlx. "auto" (default) picks cuda if a
# GPU is visible to this process, else cpu.
WHISPER_DEVICE=auto

# faster-whisper only; ignored for mlx. "auto" (default) picks float16 on
# GPU or int8 on CPU (int8 is noticeably faster than float32 on CPU, with a
# small accuracy cost).
WHISPER_COMPUTE_TYPE=auto

# pyannote diarization pipeline and device. "auto" (default) picks cuda,
# then mps (Apple Silicon, native only), then cpu -- whichever this process
# can actually see.
DIARIZATION_MODEL=pyannote/speaker-diarization-community-1
DIARIZATION_DEVICE=auto

# Comma-separated list of origins allowed to call this API (the frontend's
# own origin). Leave empty to disable CORS entirely when the frontend proxies
# requests server-side instead of calling the API from the browser.
CORS_ORIGINS=
