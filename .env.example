# Copy to .env before running `docker compose up`.

# Required: a Hugging Face read token with the pyannote Community-1
# conditions accepted: https://huggingface.co/pyannote/speaker-diarization-community-1
HF_TOKEN=hf_...

# Required Clerk application settings. Use development keys locally and the
# matching production instance's keys/issuer for a public deployment.
# Never commit real secret keys. `clerk env pull` retrieves keys locally.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
CLERK_ISSUER_URL=https://your-instance.clerk.accounts.dev
# Exact browser origin, including scheme and port; HTTPS in production.
APP_ORIGIN=http://localhost:3000

# Optional overrides -- defaults shown. See backend/.env.example for what
# each one does. All three device settings default to "auto": CUDA if
# Docker gave the container a GPU (see docker-compose.gpu.yaml), else CPU.
# WHISPER_MODEL=large-v3
# WHISPER_DEVICE=auto
# WHISPER_COMPUTE_TYPE=auto
# DIARIZATION_MODEL=pyannote/speaker-diarization-community-1
# DIARIZATION_DEVICE=auto
